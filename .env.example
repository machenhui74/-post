PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173

# OpenAI 兼容接口：DeepSeek / 通义 / GPT 都走这一组
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 本地 Ollama（同样走 OpenAI 兼容协议）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5

# 本地 oMLX（Apple Silicon，默认 :8000）。Key 可留空，会读 ~/.omlx/settings.json
OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_API_KEY=
OMLX_MODEL=
OMLX_MAX_TOKENS=8192

# Claude（可选）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# 生图：openai | none
# none=不生图；勾选「AI 生图」时必须改成 openai 并配好 OPENAI_API_KEY
IMAGE_PROVIDER=none
IMAGE_MODEL=dall-e-3
